---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.svelte';
import Topbar from '../../components/Topbar.svelte';
import SseBridge from '../../components/SseBridge.svelte';
import { apiFetch } from '../../lib/api.js';
import type { ApiList, Conversation, Folder, Mailbox, User } from '@casoon/helpdesk-types';

const token = Astro.cookies.get('token')?.value;
if (!token) return Astro.redirect('/login');

const folder = Astro.url.searchParams.get('folder') ?? 'unassigned';
const page = Number(Astro.url.searchParams.get('page') ?? '1');

// Fetch in parallel
const [convResult, foldersResult, mailboxesResult, meResult] = await Promise.allSettled([
  apiFetch<ApiList<Conversation>>(`/conversations?folder=${folder}&page=${page}&perPage=30`, { token }),
  apiFetch<{ data: Folder[] }>('/folders', { token }),
  apiFetch<{ data: Mailbox[] }>('/mailboxes', { token }),
  apiFetch<{ user: User }>('/auth/me', { token }),
]);

if (meResult.status === 'rejected' && (meResult.reason as { status?: number }).status === 401) {
  return Astro.redirect('/login');
}

const conversations = convResult.status === 'fulfilled' ? convResult.value.data : [];
const total         = convResult.status === 'fulfilled' ? convResult.value.total : 0;
const folders       = foldersResult.status === 'fulfilled' ? foldersResult.value.data : [];
const mailboxes     = mailboxesResult.status === 'fulfilled' ? mailboxesResult.value.data : [];
const me            = meResult.status === 'fulfilled' ? meResult.value.user : null;

const folderLabels: Record<string, string> = {
  unassigned: 'Unassigned', mine: 'Mine', assigned: 'All Assigned',
  drafts: 'Drafts', starred: 'Starred', closed: 'Closed', spam: 'Spam', deleted: 'Deleted',
};

function statusColor(status: string) {
  const map: Record<string, string> = {
    active: 'var(--color-status-active)',
    pending: 'var(--color-status-pending)',
    closed: 'var(--color-status-closed)',
    spam: 'var(--color-status-spam)',
  };
  return map[status] ?? 'var(--color-text-tertiary)';
}

function displayName(c: Conversation) {
  const { firstName, lastName, email } = c.customer;
  if (firstName || lastName) return [firstName, lastName].filter(Boolean).join(' ');
  return email;
}

function relativeTime(iso: string | null) {
  if (!iso) return '';
  const diff = Date.now() - new Date(iso).getTime();
  const min = Math.floor(diff / 60_000);
  if (min < 60) return `${min}m`;
  const hr = Math.floor(min / 60);
  if (hr < 24) return `${hr}h`;
  const d = Math.floor(hr / 24);
  if (d < 30) return `${d}d`;
  return new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}
---
<Layout title={folderLabels[folder] ?? 'Conversations'} variant="app">
  <Sidebar
    slot="sidebar"
    {mailboxes}
    {folders}
    activeFolderType={folder}
    client:load
  />
  {me && (
    <Topbar
      slot="topbar"
      user={me}
      title={folderLabels[folder]}
      client:load
    />
  )}
  <SseBridge client:load />

  <!-- Conversation list -->
  <div class="flex flex-col h-full">
    <!-- List header -->
    <div
      class="flex items-center justify-between border-b px-4 py-2.5"
      style="background: var(--color-surface); border-color: var(--color-border);"
    >
      <div class="flex items-center gap-2">
        <h2 class="text-sm font-semibold" style="color: var(--color-text-primary);">
          {folderLabels[folder] ?? folder}
        </h2>
        {total > 0 && (
          <span
            class="rounded-full px-1.5 py-0.5 text-xs font-medium tabular-nums"
            style="background: var(--color-accent-subtle); color: var(--color-accent-text);"
          >{total}</span>
        )}
      </div>

      <div class="flex items-center gap-1">
        <!-- Sort / filter controls placeholder -->
        <button
          class="flex items-center gap-1 rounded-md px-2 py-1 text-xs transition-colors hover:bg-gray-100"
          style="color: var(--color-text-secondary);"
        >
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5 7.5 3m0 0L12 7.5M7.5 3v13.5m13.5 0L16.5 21m0 0L12 16.5m4.5 4.5V7.5" />
          </svg>
          Newest first
        </button>
      </div>
    </div>

    <!-- Rows -->
    <div class="flex-1 overflow-y-auto" style="background: var(--color-bg);">
      {conversations.length === 0 ? (
        <div class="flex flex-col items-center justify-center py-24 text-center">
          <svg class="mb-3 h-10 w-10" style="color: var(--color-border-strong);" fill="none" viewBox="0 0 24 24" stroke-width="1" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 13.5h3.86a2.25 2.25 0 0 1 2.012 1.244l.256.512a2.25 2.25 0 0 0 2.013 1.244h3.218a2.25 2.25 0 0 0 2.013-1.244l.256-.512a2.25 2.25 0 0 1 2.013-1.244h3.859m-19.5.338V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18v-4.162c0-.224-.034-.447-.1-.661L19.24 5.338a2.25 2.25 0 0 0-2.15-1.588H6.911a2.25 2.25 0 0 0-2.151 1.588L2.35 13.177a2.25 2.25 0 0 0-.1.661Z" />
          </svg>
          <p class="text-sm font-medium" style="color: var(--color-text-secondary);">No conversations</p>
          <p class="mt-1 text-xs" style="color: var(--color-text-tertiary);">All caught up!</p>
        </div>
      ) : (
        <ul>
          {conversations.map((conv) => (
            <li>
              <a
                href={`/conversations/${conv.id}`}
                class="group flex items-start gap-3 border-b px-4 py-3 transition-colors hover:bg-white"
                style="border-color: var(--color-border);"
              >
                <!-- Avatar -->
                <div
                  class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white"
                  style={`background: var(--color-accent);`}
                >
                  {displayName(conv).slice(0, 1).toUpperCase()}
                </div>

                <!-- Content -->
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline gap-2">
                    <span class="truncate text-sm font-medium" style="color: var(--color-text-primary);">
                      {displayName(conv)}
                    </span>
                    <span class="shrink-0 text-xs tabular-nums" style="color: var(--color-text-tertiary);">
                      {relativeTime(conv.lastReplyAt)}
                    </span>
                  </div>

                  <p class="mt-0.5 truncate text-sm" style="color: var(--color-text-primary);">
                    {conv.subject}
                  </p>

                  <p class="mt-0.5 truncate text-xs" style="color: var(--color-text-tertiary);">
                    {conv.preview}
                  </p>
                </div>

                <!-- Right meta -->
                <div class="flex shrink-0 flex-col items-end gap-1.5">
                  <!-- Status dot -->
                  <span
                    class="mt-1.5 h-1.5 w-1.5 rounded-full"
                    style={`background: ${statusColor(conv.status)};`}
                  ></span>

                  {conv.hasAttachments && (
                    <svg class="h-3 w-3" style="color: var(--color-text-tertiary);" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m18.375 12.739-7.693 7.693a4.5 4.5 0 0 1-6.364-6.364l10.94-10.94A3 3 0 1 1 19.5 7.372L8.552 18.32m.009-.01-.01.01m5.699-9.941-7.81 7.81a1.5 1.5 0 0 0 2.112 2.13" />
                    </svg>
                  )}

                  {conv.assignee && (
                    <div
                      class="flex h-4 w-4 items-center justify-center rounded-full text-xs font-semibold text-white"
                      style="background: var(--color-text-tertiary); font-size: 9px;"
                      title={`${conv.assignee.firstName} ${conv.assignee.lastName}`}
                    >
                      {conv.assignee.firstName?.[0]}
                    </div>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>

    <!-- Pagination -->
    {total > 30 && (
      <div
        class="flex items-center justify-between border-t px-4 py-2.5"
        style="background: var(--color-surface); border-color: var(--color-border);"
      >
        <span class="text-xs" style="color: var(--color-text-tertiary);">
          {(page - 1) * 30 + 1}–{Math.min(page * 30, total)} of {total}
        </span>
        <div class="flex gap-1">
          {page > 1 && (
            <a
              href={`?folder=${folder}&page=${page - 1}`}
              class="rounded-md px-2.5 py-1 text-xs font-medium transition-colors hover:bg-gray-100"
              style="color: var(--color-text-secondary);"
            >Previous</a>
          )}
          {page * 30 < total && (
            <a
              href={`?folder=${folder}&page=${page + 1}`}
              class="rounded-md px-2.5 py-1 text-xs font-medium transition-colors hover:bg-gray-100"
              style="color: var(--color-text-secondary);"
            >Next</a>
          )}
        </div>
      </div>
    )}
  </div>
</Layout>
