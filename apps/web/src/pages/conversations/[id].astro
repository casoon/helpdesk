---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/Sidebar.svelte';
import Topbar from '../../components/Topbar.svelte';
import ReplyEditor from '../../components/ReplyEditor.svelte';
import TagEditor from '../../components/TagEditor.svelte';
import ConversationActions from '../../components/ConversationActions.svelte';
import { apiFetch } from '../../lib/api.js';
import type { Conversation, Folder, Mailbox, Message, User } from '@casoon/helpdesk-types';

const token = Astro.cookies.get('token')?.value;
if (!token) return Astro.redirect('/login');

const { id } = Astro.params;

const [convResult, foldersResult, mailboxesResult, meResult, tagsResult, usersResult] = await Promise.allSettled([
  apiFetch<{ conversation: Conversation & { tags: { id: string; name: string; color: string }[] }; messages: Message[] }>(`/conversations/${id}`, { token }),
  apiFetch<{ data: Folder[] }>('/folders', { token }),
  apiFetch<{ data: Mailbox[] }>('/mailboxes', { token }),
  apiFetch<{ user: User }>('/auth/me', { token }),
  apiFetch<{ data: { id: string; name: string; color: string }[] }>('/tags', { token }),
  apiFetch<{ data: { id: string; firstName: string; lastName: string; role: string; status: string }[] }>('/users', { token }),
]);

if (
  (meResult.status === 'rejected' && (meResult.reason as { status?: number }).status === 401) ||
  (convResult.status === 'rejected' && (convResult.reason as { status?: number }).status === 401)
) {
  return Astro.redirect('/login');
}

const conversation = convResult.status === 'fulfilled' ? convResult.value.conversation : null;
const messages     = convResult.status === 'fulfilled' ? convResult.value.messages : [];
const folders      = foldersResult.status === 'fulfilled' ? foldersResult.value.data : [];
const mailboxes    = mailboxesResult.status === 'fulfilled' ? mailboxesResult.value.data : [];
const me           = meResult.status === 'fulfilled' ? meResult.value.user : null;
const allTags      = tagsResult.status === 'fulfilled' ? tagsResult.value.data : [];
const agents       = usersResult.status === 'fulfilled' ? usersResult.value.data : [];

function displayName(c: Conversation) {
  const { firstName, lastName, email } = c.customer;
  if (firstName || lastName) return [firstName, lastName].filter(Boolean).join(' ');
  return email;
}

function authorName(msg: Message): string {
  if (msg.author.kind === 'agent') {
    return `${msg.author.firstName} ${msg.author.lastName}`;
  }
  if (msg.author.kind === 'customer') {
    const { firstName, lastName, email } = msg.author;
    if (firstName || lastName) return [firstName, lastName].filter(Boolean).join(' ');
    return email;
  }
  return 'System';
}

function authorInitial(msg: Message): string {
  return authorName(msg).slice(0, 1).toUpperCase();
}

function formatTime(iso: string) {
  const d = new Date(iso);
  return d.toLocaleString('en-US', {
    month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit',
  });
}

function actionLabel(msg: Message): string {
  if (!msg.actionType) return '';
  const labels: Record<string, string> = {
    status_changed: 'Status changed',
    assignee_changed: 'Assignee changed',
    moved_from_mailbox: 'Moved from mailbox',
    merged: 'Merged',
    imported: 'Imported',
    customer_changed: 'Customer changed',
    deleted: 'Deleted',
    restored: 'Restored',
  };
  const base = labels[msg.actionType] ?? msg.actionType;
  if (msg.actionData) return `${base} to ${msg.actionData}`;
  return base;
}

function statusColor(status: string) {
  const map: Record<string, string> = {
    active: 'var(--color-status-active)',
    pending: 'var(--color-status-pending)',
    closed: 'var(--color-status-closed)',
    spam: 'var(--color-status-spam)',
  };
  return map[status] ?? 'var(--color-text-tertiary)';
}

function formatBytes(bytes: number) {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}
---
<Layout title={conversation?.subject ?? 'Conversation'} variant="app">
  <Sidebar
    slot="sidebar"
    {mailboxes}
    {folders}
    client:load
  />
  {me && (
    <Topbar
      slot="topbar"
      user={me}
      title={conversation?.subject ?? 'Conversation'}
      client:load
    />
  )}

  {!conversation ? (
    <div class="flex items-center justify-center h-full">
      <p class="text-sm" style="color: var(--color-text-secondary);">Conversation not found.</p>
    </div>
  ) : (
    <div class="flex h-full min-h-0">
      <!-- Left: thread + reply -->
      <div class="flex flex-1 flex-col min-w-0 overflow-hidden">
        <!-- Thread header -->
        <div
          class="flex shrink-0 items-center gap-3 border-b px-6 py-3"
          style="background: var(--color-surface); border-color: var(--color-border);"
        >
          <a
            href="/conversations"
            class="rounded-md p-1 transition-colors hover:bg-gray-100"
            style="color: var(--color-text-tertiary);"
            aria-label="Back to conversations"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
            </svg>
          </a>
          <h1 class="text-sm font-semibold truncate flex-1" style="color: var(--color-text-primary);">
            {conversation.subject}
          </h1>
          <ConversationActions
            conversationId={conversation.id}
            status={conversation.status}
            assignee={conversation.assignee ?? null}
            {agents}
            compact={true}
            client:load
          />
        </div>

        <!-- Messages -->
        <div class="flex-1 overflow-y-auto px-6 py-4 space-y-4" style="background: var(--color-bg);">
          {messages.map((msg) => {
            if (msg.type === 'lineitem') {
              return (
                <div class="flex items-center justify-center gap-2">
                  <span
                    class="text-xs px-3 py-1 rounded-full"
                    style="background: var(--color-border); color: var(--color-text-tertiary);"
                  >
                    {actionLabel(msg)}
                  </span>
                  <span class="text-xs" style="color: var(--color-text-tertiary);">{formatTime(msg.createdAt)}</span>
                </div>
              );
            }

            const isAgent = msg.type === 'agent';
            const isNote = msg.type === 'note';
            const isCustomer = msg.type === 'customer';

            return (
              <div class={`flex gap-3 ${isAgent || isNote ? 'flex-row-reverse' : 'flex-row'}`}>
                <!-- Avatar -->
                <div
                  class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white self-start mt-1"
                  style={`background: ${isCustomer ? 'var(--color-accent)' : isNote ? '#d97706' : 'var(--color-text-secondary)'};`}
                >
                  {authorInitial(msg)}
                </div>

                <!-- Bubble -->
                <div class={`flex flex-col gap-1 max-w-[70%] ${isAgent || isNote ? 'items-end' : 'items-start'}`}>
                  {isNote && (
                    <span class="text-xs font-medium px-1" style="color: #d97706;">(Internal note)</span>
                  )}
                  <div class="flex items-baseline gap-2">
                    <span class="text-xs font-medium" style="color: var(--color-text-secondary);">
                      {authorName(msg)}
                    </span>
                    <span class="text-xs" style="color: var(--color-text-tertiary);">
                      {formatTime(msg.createdAt)}
                    </span>
                  </div>
                  <div
                    class="rounded-lg px-4 py-2.5 text-sm shadow-xs"
                    style={`
                      background: ${isNote ? '#fffbeb' : isCustomer ? 'var(--color-surface)' : 'var(--color-accent-subtle)'};
                      color: var(--color-text-primary);
                      border: 1px solid ${isNote ? '#fde68a' : 'var(--color-border)'};
                    `}
                  >
                    {msg.body ? (
                      <div set:html={msg.body} class="prose-sm max-w-none" />
                    ) : (
                      <span style="color: var(--color-text-tertiary);">(no content)</span>
                    )}
                  </div>
                  {msg.attachments.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mt-1">
                      {msg.attachments.filter(a => !a.embedded).map(att => (
                        <a
                          href={att.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="flex items-center gap-1.5 rounded-md border px-2 py-1 text-xs transition-colors hover:bg-gray-50"
                          style="border-color: var(--color-border); color: var(--color-text-secondary); background: var(--color-surface);"
                        >
                          <svg class="h-3.5 w-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" d="m18.375 12.739-7.693 7.693a4.5 4.5 0 0 1-6.364-6.364l10.94-10.94A3 3 0 1 1 19.5 7.372L8.552 18.32m.009-.01-.01.01m5.699-9.941-7.81 7.81a1.5 1.5 0 0 0 2.112 2.13" />
                          </svg>
                          <span>{att.filename}</span>
                          <span style="color: var(--color-text-tertiary);">({formatBytes(att.size)})</span>
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              </div>
            );
          })}
        </div>

        <!-- Reply editor -->
        <div
          class="shrink-0 border-t"
          style="background: var(--color-surface); border-color: var(--color-border);"
        >
          <ReplyEditor conversationId={conversation.id} client:load />
        </div>
      </div>

      <!-- Right: conversation sidebar -->
      <aside
        class="hidden lg:flex flex-col shrink-0 border-l overflow-y-auto"
        style="width: 288px; background: var(--color-surface); border-color: var(--color-border);"
      >
        <!-- Customer -->
        <div class="px-4 py-4 border-b" style="border-color: var(--color-border);">
          <p class="text-xs font-semibold uppercase tracking-wide mb-3" style="color: var(--color-text-tertiary);">Customer</p>
          <div class="flex items-center gap-3">
            <div
              class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-sm font-semibold text-white"
              style="background: var(--color-accent);"
            >
              {displayName(conversation).slice(0, 1).toUpperCase()}
            </div>
            <div class="min-w-0">
              <p class="text-sm font-medium truncate" style="color: var(--color-text-primary);">
                {displayName(conversation)}
              </p>
              <p class="text-xs truncate" style="color: var(--color-text-secondary);">
                {conversation.customer.email}
              </p>
            </div>
          </div>
        </div>

        <!-- Status + Assignee (interactive) -->
        <div class="px-4 py-3 border-b" style="border-color: var(--color-border);">
          <ConversationActions
            conversationId={conversation.id}
            status={conversation.status}
            assignee={conversation.assignee ?? null}
            {agents}
            client:load
          />
        </div>

        <!-- Tags (interactive) -->
        <div class="px-4 py-3 border-b" style="border-color: var(--color-border);">
          <TagEditor
            conversationId={conversation.id}
            currentTags={conversation.tags ?? []}
            {allTags}
            client:load
          />
        </div>

        <!-- Mailbox -->
        <div class="px-4 py-3">
          <p class="text-xs font-semibold uppercase tracking-wide mb-2" style="color: var(--color-text-tertiary);">Mailbox</p>
          <p class="text-sm" style="color: var(--color-text-primary);">{conversation.mailbox.name}</p>
          <p class="text-xs" style="color: var(--color-text-secondary);">{conversation.mailbox.email}</p>
        </div>
      </aside>
    </div>
  )}
</Layout>
